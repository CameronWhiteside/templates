/**
 * Pay Per Crawl Worker - Configuration
 *
 * Block AI crawlers with HTTP 402 Payment Required unless they pay.
 *
 * PREREQUISITES:
 *   1. Enterprise Bot Management enabled
 *   2. Pay Per Crawl Beta enabled
 *
 * Without these, the worker won't block anything.
 * Check: AI Crawl Control → Settings in dashboard
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pay-per-crawl",
	"main": "src/index.ts",
	"compatibility_date": "2026-01-30",
	"observability": { "enabled": true },
	"upload_source_maps": true,

	// =========================================================================
	// ROUTES - Where this worker runs
	// =========================================================================
	// Uncomment and edit for your domain:
	//
	// "routes": [
	// 	{ "pattern": "example.com/*", "zone_name": "example.com" }
	// ],

	"vars": {
		// =====================================================================
		// PRICING RULES
		// =====================================================================
		// Define which paths to protect and at what price.
		// Rules are checked in order - first match wins.
		//
		// Each rule needs:
		//   pattern            - Path to protect ("/blog/*" or "/api/premium")
		//   price              - Price in USD (0.09 = $0.09, minimum 0.01)
		//   bot_score_threshold - Allow if bot score >= this (30-70 typical)
		//   except_bots        - (optional) Bot names to always allow
		//
		// Bot exceptions: edit src/bots.config.ts for presets
		//
		"PRICING_RULES": [
			{
				"pattern": "/blog/*",
				"price": 0.09,
				"bot_score_threshold": 30,
				"except_bots": ["Googlebot", "BingBot"]
			},
			{
				"pattern": "/premium/*",
				"price": 0.50,
				"bot_score_threshold": 50
			}
		],

		// =====================================================================
		// BYPASS PATHS - Never blocked
		// =====================================================================
		// These paths always pass through, regardless of bot score.
		//
		"BYPASS_PATHS": [
			"/robots.txt",
			"/crawlers.json",
			"/security.txt",
			"/.well-known/security.txt",
			"/ads.txt"
		]
	}
}
